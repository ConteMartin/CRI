# Rewrite extensionless URLs for CRI
RewriteEngine On

# Si entra a /cotizacion redirige internamente a cotizacion.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^cotizacion/?$ cotizacion.html [L]

# Si entra a /gracias redirige internamente a gracias.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^gracias/?$ gracias.html [L]

# Forzar HTTPS si está disponible
<IfModule mod_rewrite.c>
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>
